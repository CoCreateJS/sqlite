{
  "name": "@cocreate/sqlite",
  "version": "1.4.1",
  "description": "Lightweight SQLite CRUD wrapper and multi-tenant state routing client for the CoCreate ecosystem.",
  "keywords": [
    "sqlite",
    "sqlite3",
    "sql",
    "json",
    "crud-api",
    "abstract-crud",
    "database-abstraction",
    "multi-tenant",
    "multi-tenant-routing",
    "realtime-sync",
    "state-synchronization",
    "state-routing",
    "embedded-replicas"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "start": "webpack --config webpack.config.js",
    "build": "webpack --mode=production --config webpack.config.js",
    "dev": "webpack --config webpack.config.js --watch"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CoCreate-app/CoCreate-sqlite.git"
  },
  "author": "CoCreate LLC",
  "license": "AGPL-3.0",
  "bugs": {
    "url": "https://github.com/CoCreate-app/CoCreate-sqlite/issues"
  },
  "homepage": "https://cocreate.app/docs/sqlite",
  "funding": {
    "type": "GitHub Sponsors ❤",
    "url": "https://github.com/sponsors/CoCreate-app"
  },
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./dist": "./dist/sqlite.js",
    "./installer": "./installer/sqlite.installer.js"
  },
  "devDependencies": {
    "@cocreate/webpack": "^1.7.0"
  },
  "dependencies": {
    "@cocreate/utils": "^1.50.0",
    "@libsql/client": "^0.6.0"
  }
